{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@tests/*": [
        "__tests__/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "strictPropertyInitialization": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "assets/tiles/*.tsx",
    "node_modules"
  ]
}
